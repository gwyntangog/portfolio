---
// src/components/AskMe.astro
---

<button class="ask-trigger" id="ask-trigger" aria-label="Ask me anything">
  Hi, I'm Gwyn's Mini-Chat!
</button>

<div class="ask-overlay" id="ask-overlay" aria-hidden="true">
  <div class="ask-panel">
    <div class="ask-header">
      <span>Ask Gwyn's Mini-Chat</span>
      <button class="ask-close" id="ask-close" aria-label="Close">✕</button>
    </div>

    <div class="ask-messages" id="ask-messages">
      <div class="message assistant">
        Hi! Ask me anything about Gwyn — her background, projects, or skills.
      </div>
    </div>

    <form class="ask-form" id="ask-form" autocomplete="off">
      <input
        class="ask-input"
        id="ask-input"
        type="text"
        placeholder="What are you working on at MIT?"
        maxlength="300"
      />
      <button class="ask-send" type="submit" aria-label="Send">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  .ask-trigger {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 100;
    padding: 10px 18px;
    border-radius: 999px;
    border: none;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0,0,0,0.18);
    transition: transform 0.15s ease, opacity 0.15s ease;
  }
  .ask-trigger:hover { transform: translateY(-2px); opacity: 0.9; }

  /* fullscreen dimmed overlay */
  .ask-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(2px);
    align-items: flex-end;
    justify-content: flex-end;
    padding: 28px;
  }
  .ask-overlay.is-open {
    display: flex;
    animation: fadeIn 0.2s ease;
  }

  .ask-panel {
    display: flex;
    flex-direction: column;
    width: min(420px, 100%);
    height: min(520px, 80vh);
    background: var(--bg-panel, #fff);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 48px rgba(0,0,0,0.22);
    animation: slideUp 0.25s ease;
  }

  .ask-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    border-bottom: 1px solid rgba(0,0,0,0.07);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--blue);
  }
  .ask-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
    color: inherit;
    opacity: 0.6;
    line-height: 1;
  }
  .ask-close:hover { opacity: 1; }

  .ask-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .message {
    max-width: 85%;
    padding: 9px 13px;
    border-radius: 12px;
    font-size: 0.9rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }
  .message.user {
    align-self: flex-end;
    background: var(--blue);
    color: #fff;
    border-bottom-right-radius: 3px;
  }
  .message.assistant {
    align-self: flex-start;
    background: rgba(0,0,0,0.06);
    border-bottom-left-radius: 3px;
  }
  .message.assistant.is-streaming::after {
    content: '▍';
    animation: blink 0.7s step-end infinite;
  }

  .ask-form {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid rgba(0,0,0,0.07);
  }
  .ask-input {
    flex: 1;
    border: 1px solid rgba(0,0,0,0.12);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 0.9rem;
    outline: none;
    background: transparent;
  }
  .ask-input:focus { border-color: var(--blue); }

  .ask-send {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border: none;
    border-radius: 8px;
    background: var(--blue);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: opacity 0.15s;
  }
  .ask-send:hover   { opacity: 0.85; }
  .ask-send:disabled { opacity: 0.4; cursor: not-allowed; }

  @keyframes fadeIn  { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideUp { from { transform: translateY(16px); opacity: 0; }
                       to   { transform: translateY(0);    opacity: 1; } }
  @keyframes blink   { 50% { opacity: 0; } }
</style>


<script>
  const trigger  = document.getElementById('ask-trigger')!;
  const overlay  = document.getElementById('ask-overlay')!;

  let initialized = false;

  function initialize() {
    if (initialized) return;
    initialized = true;

    // All DOM queries deferred to first open
    const closeBtn = document.getElementById('ask-close')!;
    const form     = document.getElementById('ask-form') as HTMLFormElement;
    const input    = document.getElementById('ask-input') as HTMLInputElement;
    const messages = document.getElementById('ask-messages')!;

    // Conversation history — only allocated once the user actually opens the chat
    const history: { role: 'user' | 'assistant'; content: string }[] = [];

    function addMessage(role: 'user' | 'assistant', text = '') {
      const el = document.createElement('div');
      el.className = `message ${role}`;
      el.textContent = text;
      messages.appendChild(el);
      messages.scrollTop = messages.scrollHeight;
      return el;
    }

    // Close handlers — set up here so they don't exist before the chat opens
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      input.value = '';
      input.disabled = true;
      (form.querySelector('.ask-send') as HTMLButtonElement).disabled = true;

      addMessage('user', text);
      history.push({ role: 'user', content: text });

      const replyEl = addMessage('assistant');
      replyEl.classList.add('is-streaming');
      let reply = '';

      try {
        const res = await fetch('https://portfolio-chat.gwynmgtangog.workers.dev/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });

        if (res.status === 429) {
          replyEl.textContent = "You've reached the message limit — please come back in an hour.";
          return;
        }

        const reader  = res.body!.getReader();
        const decoder = new TextDecoder();

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          const lines = decoder.decode(value).split('\n');
          for (const line of lines) {
            if (!line.startsWith('data: ')) continue;
            const data = line.slice(6).trim();
            if (!data || data === '[DONE]') continue;

            try {
              const parsed = JSON.parse(data);
              if (
                parsed.type === 'content_block_delta' &&
                parsed.delta?.type === 'text_delta'
              ) {
                reply += parsed.delta.text;
                replyEl.textContent = reply;
                messages.scrollTop  = messages.scrollHeight;
              }
            } catch { /* incomplete chunk, skip */ }
          }
        }
      }  catch (err) {
        console.error('Chat error:', err);  // ← add this
        replyEl.textContent = 'Something went wrong — please try again.';
        }
    // catch {
    //     replyEl.textContent = 'Something went wrong — please try again.';}
         finally {
        replyEl.classList.remove('is-streaming');
        history.push({ role: 'assistant', content: reply });
        input.disabled = false;
        (form.querySelector('.ask-send') as HTMLButtonElement).disabled = false;
        input.focus();
      }
    });
  }

  function open() {
    initialize(); // no-op after first call
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.getElementById('ask-input')?.focus();
  }

  function close() {
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
  }

  trigger.addEventListener('click', open);
</script>
